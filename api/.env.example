# Copy to api/.env  (Adobe secrets live here — never commit)

# Bind — loopback only (non-local hosts are rejected)
API_HOST=127.0.0.1
API_PORT=3000
API_VERSION=0.1.0
API_ENV=development
API_SERVICE_NAME=Adobe Tags API
LOG_LEVEL=INFO

# MCP -> API service auth (recommended true even on localhost)
AUTH_ENABLED=true
MCP_API_KEY=replace-with-a-long-random-secret

# Adobe auth mode: user_oauth | server_to_server  (one mode per API process)
ADOBE_AUTH_MODE=server_to_server

# Shared Adobe app fields (both modes)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=
ADOBE_SCOPES=AdobeID, openid, read_organizations, additional_info.job_function, additional_info.projectedProductContext, additional_info.roles
ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3

# Mode A — User OAuth (set ADOBE_AUTH_MODE=user_oauth, then open /auth/adobe/start)
ADOBE_IMS_AUTHORIZE_URL=https://ims-na1.adobelogin.com/ims/authorize/v2
ADOBE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/adobe/callback

# Reactor + encrypted session vault (path relative to repo root)
REACTOR_BASE_URL=https://reactor.adobe.io
DATA_DIR=./data
# VAULT_KEY=generate-a-long-random-key-for-encrypted-session-file

# Pagination
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=50