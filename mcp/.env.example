# Copy to mcp/.env  (no Adobe secrets here — MCP talks only to the local API)

# Local API target (must match api/.env host/port)
API_BASE_URL=http://127.0.0.1:3000
# find_usage / activity can take longer than short CRUD calls
API_TIMEOUT_SECONDS=120
API_MAX_RETRIES=2

# Must match api/.env when AUTH_ENABLED=true there
AUTH_ENABLED=true
MCP_API_KEY=replace-with-a-long-random-secret

MCP_SERVER_NAME=Adobe Tags MCP
LOG_LEVEL=INFO

# Prefer stdio for ChatGPT Desktop / Cursor local adapters stdio/streamable-http
MCP_TRANSPORT=stdio

# Streamable HTTP (local only — non-loopback hosts are rejected)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp
MCP_HTTP_HEALTH_PATH=/health
MCP_HTTP_STATELESS=true
MCP_HTTP_JSON_RESPONSE=true
MCP_HTTP_MAX_REQUEST_BODY_BYTES=4194304